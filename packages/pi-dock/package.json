{
    "name": "@lune_99/pi-dock",
    "version": "0.1.0",
    "description": "A compact keyboard-operated dock for Lune Pi extensions",
    "type": "module",
    "files": [
        "src",
        "docs",
        "README.md",
        "CHANGELOG.md",
        "LICENSE"
    ],
    "publishConfig": {
        "access": "public"
    },
    "pi": {
        "extensions": [
            "./src/index.ts"
        ],
        "image": "./docs/dock-overview.png"
    },
    "scripts": {
        "typecheck": "tsc --noEmit",
        "test": "node --experimental-strip-types --test 'test/**/*.test.ts'",
        "tui:demo": "node --experimental-strip-types test/tui/launch.ts",
        "docs:images": "node --experimental-strip-types tools/make-doc-images.mjs"
    },
    "dependencies": {
        "@lune_99/pi-lune-extensions-core": "^0.1.0"
    },
    "peerDependencies": {
        "@earendil-works/pi-coding-agent": ">=1.0.4",
        "@earendil-works/pi-tui": ">=1.0.4",
        "typebox": ">=1.3.27"
    },
    "devDependencies": {
        "@earendil-works/pi-coding-agent": "1.3.0",
        "@earendil-works/pi-tui": "1.3.0",
        "@types/node": "^22.20.2",
        "typebox": "1.3.27",
        "typescript": "5.9.3"
    },
    "engines": {
        "node": ">=22.19.0"
    },
    "author": "Nouvelle-Lune",
    "license": "MIT",
    "keywords": [
        "pi-package",
        "pi",
        "dock",
        "lune",
        "tui"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Nouvelle-Lune/lune-pi.git",
        "directory": "packages/pi-dock"
    },
    "homepage": "https://github.com/Nouvelle-Lune/lune-pi/tree/main/packages/pi-dock#readme",
    "bugs": {
        "url": "https://github.com/Nouvelle-Lune/lune-pi/issues"
    }
}
