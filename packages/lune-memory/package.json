{
    "name": "@lune_99/lune-memory",
    "version": "0.1.0",
    "description": "Cross-harness project memory for Pi, Codex and Claude Code, maintained by background Dreaming",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./pi-extension": {
            "types": "./dist/pi-extension.d.ts",
            "default": "./dist/pi-extension.js"
        }
    },
    "bin": {
        "lune-memory": "./bin/lune-memory.js",
        "lune-memoryd": "./bin/lune-memoryd.js"
    },
    "files": [
        "bin",
        "dist",
        "docs",
        "ui",
        "README.md",
        "CHANGELOG.md",
        "LICENSE",
        "THIRD_PARTY_NOTICES.md"
    ],
    "pi": {
        "extensions": [
            "./dist/pi-extension.js"
        ]
    },
    "scripts": {
        "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
        "typecheck": "tsc --noEmit",
        "test": "node --experimental-strip-types --test 'test/**/*.test.ts'",
        "prepack": "npm run build"
    },
    "engines": {
        "node": ">=22.19.0"
    },
    "keywords": [
        "pi-package",
        "pi",
        "pi-coding-agent",
        "memory",
        "mcp"
    ],
    "license": "MIT",
    "author": "Nouvelle-Lune",
    "dependencies": {
        "fastify": "^5.12.8"
    },
    "peerDependencies": {
        "@earendil-works/pi-ai": ">=1.3.0",
        "@earendil-works/pi-coding-agent": ">=1.0.4",
        "typebox": ">=1.3.27"
    },
    "peerDependenciesMeta": {
        "@earendil-works/pi-coding-agent": {
            "optional": true
        }
    },
    "devDependencies": {
        "@earendil-works/pi-ai": "1.3.0",
        "@earendil-works/pi-coding-agent": "1.3.0",
        "@types/node": "^22.20.2",
        "typebox": "1.3.27",
        "typescript": "5.9.3"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Nouvelle-Lune/lune-pi.git",
        "directory": "packages/lune-memory"
    },
    "homepage": "https://github.com/Nouvelle-Lune/lune-pi/tree/main/packages/lune-memory#readme",
    "bugs": {
        "url": "https://github.com/Nouvelle-Lune/lune-pi/issues"
    }
}
