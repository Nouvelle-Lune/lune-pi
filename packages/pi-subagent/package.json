{
    "name": "@lune_99/pi-subagent",
    "version": "0.1.0",
    "description": "Subagent runs for pi: delegated tasks in separate sessions, a Dock entry and an /agents inspector",
    "type": "module",
    "files": [
        "src",
        "README.md",
        "CHANGELOG.md",
        "LICENSE"
    ],
    "pi": {
        "extensions": [
            "./src/index.ts"
        ]
    },
    "scripts": {
        "test": "node --experimental-strip-types --test 'test/**/*.test.ts'",
        "typecheck": "tsc --noEmit"
    },
    "keywords": [
        "pi-package",
        "pi",
        "pi-coding-agent",
        "subagent",
        "agents",
        "delegation",
        "worktree",
        "tui"
    ],
    "author": "Nouvelle-Lune",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Nouvelle-Lune/lune-pi.git",
        "directory": "packages/pi-subagent"
    },
    "homepage": "https://github.com/Nouvelle-Lune/lune-pi/tree/main/packages/pi-subagent#readme",
    "bugs": {
        "url": "https://github.com/Nouvelle-Lune/lune-pi/issues"
    },
    "engines": {
        "node": ">=22.19.0"
    },
    "dependencies": {
        "@lune_99/pi-lune-extensions-core": "^0.1.0"
    },
    "peerDependencies": {
        "@earendil-works/pi-coding-agent": ">=1.3.0",
        "@earendil-works/pi-tui": ">=1.3.0",
        "typebox": "*"
    },
    "peerDependenciesMeta": {
        "@earendil-works/pi-coding-agent": {
            "optional": true
        },
        "@earendil-works/pi-tui": {
            "optional": true
        },
        "typebox": {
            "optional": true
        }
    },
    "devDependencies": {
        "@earendil-works/pi-agent-core": "1.3.0",
        "@earendil-works/pi-ai": "1.3.0",
        "@earendil-works/pi-coding-agent": "1.3.0",
        "@earendil-works/pi-tui": "1.3.0",
        "@types/node": "^22.20.2",
        "typebox": "1.3.27",
        "typescript": "5.9.3"
    }
}
