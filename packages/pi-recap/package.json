{
    "name": "@lune_99/pi-recap",
    "version": "0.1.0",
    "description": "Independent session recap for Pi using Lune Core settings and panel infrastructure",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/extension.d.ts",
            "default": "./dist/extension.js"
        }
    },
    "files": [
        "dist",
        "docs",
        "README.md",
        "CHANGELOG.md",
        "LICENSE"
    ],
    "pi": {
        "extensions": [
            "./dist/extension.js"
        ],
        "image": "./docs/recap-widget.png"
    },
    "scripts": {
        "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
        "typecheck": "tsc --noEmit",
        "test": "node --experimental-strip-types --test 'test/**/*.test.ts'",
        "tui:demo": "node --experimental-strip-types test/tui/launch.ts",
        "tui:smoke": "python3 test/tui/recap-smoke.py",
        "prepack": "npm run build",
        "docs:images": "node --experimental-strip-types tools/make-doc-images.mjs"
    },
    "engines": {
        "node": ">=22.19.0"
    },
    "keywords": [
        "pi-package",
        "pi",
        "pi-coding-agent"
    ],
    "license": "MIT",
    "author": "Nouvelle-Lune",
    "dependencies": {
        "@lune_99/pi-lune-extensions-core": "^0.1.0"
    },
    "peerDependencies": {
        "@earendil-works/pi-ai": ">=1.0.4",
        "@earendil-works/pi-coding-agent": ">=1.0.4",
        "@earendil-works/pi-tui": ">=1.0.0",
        "typebox": ">=1.3.27"
    },
    "devDependencies": {
        "@earendil-works/pi-ai": "1.3.0",
        "@earendil-works/pi-coding-agent": "1.3.0",
        "@earendil-works/pi-tui": "1.3.0",
        "@types/node": "^22.20.2",
        "typebox": "1.3.27",
        "typescript": "5.9.3"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Nouvelle-Lune/lune-pi.git",
        "directory": "packages/pi-recap"
    },
    "homepage": "https://github.com/Nouvelle-Lune/lune-pi/tree/main/packages/pi-recap#readme",
    "bugs": {
        "url": "https://github.com/Nouvelle-Lune/lune-pi/issues"
    }
}
