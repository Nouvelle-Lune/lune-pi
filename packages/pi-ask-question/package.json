{
    "name": "@lune_99/pi-ask-question",
    "version": "0.1.0",
    "description": "Ask the user questions for pi via tool and command",
    "type": "module",
    "files": [
        "src",
        "docs",
        "README.md",
        "CHANGELOG.md",
        "LICENSE"
    ],
    "pi": {
        "extensions": [
            "./src/index.ts"
        ],
        "image": "./docs/question-panel.png"
    },
    "scripts": {
        "test": "node --experimental-strip-types --test 'test/**/*.test.ts'",
        "typecheck": "tsc --noEmit",
        "tui:demo": "node --experimental-strip-types test/tui/launch.ts",
        "docs:images": "node --experimental-strip-types tools/make-doc-images.mjs",
        "prepublishOnly": "npm run typecheck && npm test"
    },
    "keywords": [
        "pi-package",
        "pi",
        "pi-coding-agent",
        "ask",
        "question"
    ],
    "author": "Nouvelle-Lune",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Nouvelle-Lune/lune-pi.git",
        "directory": "packages/pi-ask-question"
    },
    "homepage": "https://github.com/Nouvelle-Lune/lune-pi/tree/main/packages/pi-ask-question#readme",
    "bugs": {
        "url": "https://github.com/Nouvelle-Lune/lune-pi/issues"
    },
    "engines": {
        "node": ">=22.19.0"
    },
    "peerDependencies": {
        "@earendil-works/pi-coding-agent": "*",
        "@earendil-works/pi-tui": "*",
        "typebox": "*"
    },
    "devDependencies": {
        "@earendil-works/pi-ai": "1.3.0",
        "@earendil-works/pi-coding-agent": "1.3.0",
        "@earendil-works/pi-tui": "1.3.0",
        "@types/node": "^22.20.2",
        "typebox": "1.3.27",
        "typescript": "5.9.3"
    },
    "dependencies": {
        "@lune_99/pi-lune-extensions-core": "^0.1.0"
    }
}
